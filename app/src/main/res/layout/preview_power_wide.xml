<?xml version="1.0" encoding="utf-8"?>
<!-- 静态 picker 使用生产空态，不用字符画伪造走势；App 内预览使用真实 Glance 与缓存样本。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/preview_glass" android:orientation="vertical" android:padding="@dimen/widget_padding">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="宿舍电量" android:textSize="@dimen/widget_text_title" android:textStyle="bold"
            android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_gap"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:background="@drawable/preview_badge"
            android:text="七天" android:textSize="@dimen/widget_text_caption" android:textStyle="bold"
            android:textColor="@color/widget_accent_text" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_small_gap"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp"
            android:text="半月" android:textSize="@dimen/widget_text_caption" android:textColor="@color/widget_sub" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom"
        android:layout_marginTop="@dimen/widget_small_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textSize="@dimen/widget_text_number" android:textStyle="bold"
            android:textColor="@color/widget_text" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_small_gap"
            android:text="度" android:textSize="@dimen/widget_text_label" android:textColor="@color/widget_sub" android:maxLines="1" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="等待采样积累走势" android:textSize="@dimen/widget_text_caption" android:textColor="@color/widget_sub"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
