<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_glass"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="今天 · 第 1 周"
        android:textSize="12sp"
        android:textColor="@color/widget_text" android:textStyle="bold" android:layout_weight="1" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="剩 3 堂"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" android:gravity="end" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/preview_badge"
        android:text="1-2"
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="高等数学"
        android:textSize="12sp"
        android:textColor="@color/widget_text" android:layout_weight="1" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="教学楼A-301"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/preview_badge"
        android:text="3-4"
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="数据结构"
        android:textSize="12sp"
        android:textColor="@color/widget_text" android:layout_weight="1" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="实验楼C-102"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/preview_badge"
        android:text="5-6"
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="大学英语"
        android:textSize="12sp"
        android:textColor="@color/widget_text" android:layout_weight="1" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="教学楼B-205"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
    </LinearLayout>
</LinearLayout>
