<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/preview_glass" android:orientation="vertical" android:padding="@dimen/widget_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="下一节 · 08:30" android:textSize="@dimen/widget_text_title" android:textStyle="bold"
        android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_gap"
        android:text="高等数学" android:textSize="@dimen/widget_text_headline" android:textStyle="bold"
        android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
            android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:background="@drawable/preview_badge"
            android:text="1-2" android:textSize="@dimen/widget_text_caption" android:textStyle="bold"
            android:textColor="@color/widget_accent_text" android:maxLines="1" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="@dimen/widget_gap" android:text="教学楼A-301" android:textSize="@dimen/widget_text_label"
            android:textColor="@color/widget_sub" android:gravity="end" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_small_gap"
        android:text="2.1 小时后" android:textSize="@dimen/widget_text_label" android:textStyle="bold"
        android:textColor="@color/widget_accent_text" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
