<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/preview_glass"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下一节 · 08:30"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="高等数学"
        android:textSize="15sp"
        android:textColor="@color/widget_text" android:textStyle="bold" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/preview_badge"
        android:text="1-2"
        android:textSize="11sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="教学楼A-301"
        android:textSize="11sp"
        android:textColor="@color/widget_sub" />
    </LinearLayout>
    <TextView android:maxLines="1" android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2.1 小时后"
        android:textSize="11sp"
        android:textColor="@color/widget_accent" android:textStyle="bold" />
</LinearLayout>
