<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/preview_glass" android:orientation="vertical"
    android:gravity="center_horizontal" android:padding="@dimen/widget_padding_tall">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:background="@drawable/preview_badge"
        android:text="电量" android:textSize="@dimen/widget_text_caption" android:textStyle="bold"
        android:textColor="@color/widget_accent_text" android:gravity="center" android:maxLines="1" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="—" android:textSize="@dimen/widget_text_tall_number" android:textStyle="bold"
        android:textColor="@color/widget_text" android:gravity="center" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="度" android:textSize="@dimen/widget_text_label" android:textColor="@color/widget_sub"
        android:gravity="center" android:maxLines="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_small_gap"
        android:text="宿舍" android:textSize="@dimen/widget_text_caption" android:textColor="@color/widget_sub"
        android:gravity="center" android:maxLines="2" android:ellipsize="end" />
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="近 7 天" android:textSize="@dimen/widget_text_caption" android:textColor="@color/widget_sub"
        android:gravity="center" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
