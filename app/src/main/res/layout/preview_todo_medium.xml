<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/preview_glass" android:orientation="vertical" android:padding="@dimen/widget_padding">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="待办" android:textSize="@dimen/widget_text_title" android:textStyle="bold"
        android:textColor="@color/widget_text" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="bottom"
        android:layout_marginTop="@dimen/widget_small_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="4" android:textSize="@dimen/widget_text_number" android:textStyle="bold"
            android:textColor="@color/widget_text" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_small_gap"
            android:text="项" android:textSize="@dimen/widget_text_label" android:textColor="@color/widget_sub" android:maxLines="1" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="高数期中考试（A栋101）" android:textSize="@dimen/widget_text_body" android:textColor="@color/widget_text"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/widget_small_gap"
        android:text="今天 14:20" android:textSize="@dimen/widget_text_label" android:textColor="@color/widget_sub"
        android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
