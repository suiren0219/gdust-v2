<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- 拾光 GDUST 适配的教务内网与校外入口使用 HTTP，仅放行这两个主机。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.16.254.1</domain>
        <!-- 抓包确认的校内五育综合数据平台网页入口。 -->
        <domain includeSubdomains="false">172.16.1.232</domain>
        <domain includeSubdomains="false">gkjx.gdust.edu.cn</domain>
        <!-- 超星泛雅加速域只有 HTTP（443 无响应，实测）：CAS 单点会依次跳到 fysso / fanya / passport2 -->
        <domain includeSubdomains="true">fysso.chaoxing.com</domain>
        <domain includeSubdomains="true">fanya.chaoxing.com</domain>
        <domain includeSubdomains="true">passport2.chaoxing.com</domain>
        <domain includeSubdomains="true">passport.chaoxing.com</domain>
        <domain includeSubdomains="true">mooc1-api.chaoxing.com</domain>
        <domain includeSubdomains="true">mooc1.chaoxing.com</domain>
    </domain-config>
</network-security-config>
