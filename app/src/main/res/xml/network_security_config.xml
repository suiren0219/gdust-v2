<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- 拾光 GDUST 适配的教务内网与校外入口使用 HTTP，仅放行这两个主机。 -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">172.16.254.1</domain>
        <domain includeSubdomains="false">gkjx.gdust.edu.cn</domain>
        <!-- 超星泛雅加速域只有 HTTP（443 无响应，实测），CAS 单点会跳到这里 -->
        <domain includeSubdomains="false">gdkjxy.fysso.chaoxing.com</domain>
    </domain-config>
</network-security-config>
